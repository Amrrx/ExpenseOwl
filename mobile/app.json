{
  "expo": {
    "name": "Clink",
    "slug": "clink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "clink",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f9fafb"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clink.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f9fafb"
      },
      "package": "com.clink.app",
      "permissions": ["RECORD_AUDIO", "CAMERA", "READ_EXTERNAL_STORAGE"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "mainActivityLaunchMode": "singleTask"
          }
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsImageWithMaxCount": 1
          },
          "androidIntentFilters": ["image/*"]
        }
      ],
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Clink to access your microphone for voice expense entry."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Clink to access your photos to scan receipts.",
          "cameraPermission": "Allow Clink to use your camera to scan receipts."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "QuickExpense",
              "label": "Quick Expense",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "description": "Add expense via voice or camera",
              "previewImage": "./assets/widget-preview.png",
              "resizeMode": "none"
            }
          ]
        }
      ],
      "@react-native-google-signin/google-signin"
    ]
  }
}
